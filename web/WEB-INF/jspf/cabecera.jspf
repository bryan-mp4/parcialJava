<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= esc(tituloPagina) %> | Habitat UTS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="<%= request.getContextPath() %>/css/estilos.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="<%= request.getContextPath() %>/index.jsp"><i class="bi bi-buildings"></i> Habitat UTS</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/propiedades.jsp"><i class="bi bi-search"></i> Propiedades</a></li>
        <% if ("CLIENTE".equals(rolSesion)) { %>
        <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/cliente/panel.jsp">Mi espacio</a></li>
        <% } %>
        <% if ("INMOBILIARIA".equals(rolSesion)) { %>
        <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/inmobiliaria/panel.jsp">Gestión inmobiliaria</a></li>
        <% } %>
        <% if ("ADMINISTRADOR".equals(rolSesion)) { %>
        <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/administrador/panel.jsp">Administración</a></li>
        <% } %>
      </ul>
      <% if (idUsuarioSesion != null) { %>
      <span class="navbar-text text-white me-3"><i class="bi bi-person-circle"></i> <%= esc(nombreSesion) %> <span class="badge text-bg-warning"><%= esc(rolSesion) %></span></span>
      <a class="btn btn-outline-light btn-sm" href="<%= request.getContextPath() %>/logout.jsp"><i class="bi bi-box-arrow-right"></i> Salir</a>
      <% } else { %>
      <a class="btn btn-outline-light btn-sm" href="<%= request.getContextPath() %>/login.jsp">Ingresar</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="container my-4">
<% if (request.getParameter("msg") != null) { %><div class="alert alert-success"><%= esc(request.getParameter("msg")) %></div><% } %>
<% if (request.getParameter("err") != null) { %><div class="alert alert-danger"><%= esc(request.getParameter("err")) %></div><% } %>