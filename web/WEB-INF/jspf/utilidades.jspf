<%@ page import="java.security.MessageDigest,java.text.NumberFormat,java.util.Locale" %>
<%!
    public String sha256(String texto) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] resumen = md.digest(texto.getBytes("UTF-8"));
            StringBuilder resultado = new StringBuilder();
            for (byte b : resumen) resultado.append(String.format("%02x", b));
            return resultado.toString();
        } catch (Exception ex) {
            throw new RuntimeException("No fue posible cifrar la clave", ex);
        }
    }

    public String claveCifrada(String usuario, String clave) { return sha256(usuario + ":" + clave); }

    public String pesos(double valor) {
        NumberFormat formato = NumberFormat.getInstance(new Locale("es", "CO"));
        formato.setMaximumFractionDigits(0);
        return "$ " + formato.format(valor);
    }

    public int aEntero(String valor, int defecto) {
        try { return Integer.parseInt(valor.trim()); } catch (Exception ex) { return defecto; }
    }

    public double aDoble(String valor, double defecto) {
        try { return Double.parseDouble(valor.trim().replace(",", ".")); } catch (Exception ex) { return defecto; }
    }

    public String esc(String texto) {
        if (texto == null) return "";
        return texto.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                    .replace("\"", "&quot;").replace("'", "&#39;");
    }

    public String colorEstado(String estado) {
        if (estado == null) return "secondary";
        if ("APROBADA".equals(estado) || "CONFIRMADA".equals(estado) || "ACTIVO".equals(estado)) return "success";
        if ("PENDIENTE".equals(estado) || "EN_REVISION".equals(estado)) return "warning";
        if ("RECHAZADA".equals(estado) || "CANCELADA".equals(estado) || "INACTIVO".equals(estado)) return "danger";
        return "secondary";
    }
%>