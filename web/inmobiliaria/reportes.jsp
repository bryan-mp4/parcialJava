<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String tituloPagina="Reportes";String[] rolesPermitidos={"INMOBILIARIA"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Reportes operativos</h1><p class="text-muted">Consultas consolidadas para decidir y hacer seguimiento.</p><%Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();%><h2 class="h5 mt-4">Propiedades, ubicación y responsable</h2><div class="table-responsive bg-white shadow-sm"><table class="table"><thead><tr><th>Propiedad</th><th>Ciudad</th><th>Tipo</th><th>Inmobiliaria</th></tr></thead><tbody><%ps=con.prepareStatement("SELECT p.titulo,c.nombre ciudad,t.nombre tipo,i.nombre inmobiliaria FROM propiedad p INNER JOIN ciudad c ON c.id_ciudad=p.id_ciudad INNER JOIN tipo_propiedad t ON t.id_tipo=p.id_tipo INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE i.id_usuario=?");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td><td><%=esc(rs.getString(2))%></td><td><%=esc(rs.getString(3))%></td><td><%=esc(rs.getString(4))%></td></tr><%}cerrar(rs,ps);%></tbody></table></div><h2 class="h5 mt-4">Características por propiedad (N:M)</h2><div class="table-responsive bg-white shadow-sm"><table class="table"><thead><tr><th>Propiedad</th><th>Características</th></tr></thead><tbody><%ps=con.prepareStatement("SELECT p.titulo,GROUP_CONCAT(car.nombre ORDER BY car.nombre SEPARATOR ', ') caracteristicas FROM propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria LEFT JOIN propiedad_caracteristica pc ON pc.id_propiedad=p.id_propiedad LEFT JOIN caracteristica car ON car.id_caracteristica=pc.id_caracteristica WHERE i.id_usuario=? GROUP BY p.id_propiedad,p.titulo");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td><td><%=esc(rs.getString(2))%></td></tr><%}cerrar(rs,ps);%></tbody></table></div><h2 class="h5 mt-4">Propiedades sin citas (LEFT JOIN)</h2><div class="table-responsive bg-white shadow-sm"><table class="table"><thead><tr><th>Propiedad</th></tr></thead><tbody><%ps=con.prepareStatement("SELECT p.titulo FROM propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria LEFT JOIN cita c ON c.id_propiedad=p.id_propiedad WHERE i.id_usuario=? GROUP BY p.id_propiedad,p.titulo HAVING COUNT(c.id_cita)=0");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td></tr><%}cerrar(rs,ps);%></tbody></table></div><h2 class="h5 mt-4">Citas por estado (GROUP BY / HAVING)</h2><div class="table-responsive bg-white shadow-sm"><table class="table"><thead><tr><th>Estado</th><th>Total</th></tr></thead><tbody><%ps=con.prepareStatement("SELECT c.estado,COUNT(*) total FROM cita c INNER JOIN propiedad p ON p.id_propiedad=c.id_propiedad INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE i.id_usuario=? GROUP BY c.estado HAVING COUNT(*)>0");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td><td><%=rs.getInt(2)%></td></tr><%}}catch(SQLException ex){%><div class="alert alert-danger">No fue posible generar los reportes.</div><%}finally{cerrar(rs,ps,con);}%><%@ include file="/WEB-INF/jspf/pie.jspf" %>