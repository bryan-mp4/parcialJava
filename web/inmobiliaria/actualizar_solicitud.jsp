<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String ctx=request.getContextPath();String[] rolesPermitidos={"INMOBILIARIA"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%int id=aEntero(request.getParameter("id"),0);String estado=request.getParameter("estado");Connection con=null;PreparedStatement ps=null;try{con=abrirConexion();ps=con.prepareStatement("UPDATE solicitud s INNER JOIN propiedad p ON p.id_propiedad=s.id_propiedad INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria SET s.estado=? WHERE s.id_solicitud=? AND i.id_usuario=?");ps.setString(1,estado);ps.setInt(2,id);ps.setInt(3,idUsuarioSesion);ps.executeUpdate();response.sendRedirect(ctx+"/inmobiliaria/solicitudes.jsp?msg=Solicitud actualizada");}catch(SQLException ex){response.sendRedirect(ctx+"/inmobiliaria/solicitudes.jsp?err=No fue posible actualizar la solicitud");}finally{cerrar(ps,con);}%>