<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><% String ctx=request.getContextPath();String[] rolesPermitidos={"INMOBILIARIA"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><% int id=aEntero(request.getParameter("id"),0),ciudad=aEntero(request.getParameter("ciudad"),0),tipo=aEntero(request.getParameter("tipo"),0),habitaciones=aEntero(request.getParameter("habitaciones"),0),banos=aEntero(request.getParameter("banos"),0);double precio=aDoble(request.getParameter("precio"),0),area=aDoble(request.getParameter("area"),0);String titulo=request.getParameter("titulo"),matricula=request.getParameter("matricula"),direccion=request.getParameter("direccion"),descripcion=request.getParameter("descripcion"),imagen=request.getParameter("imagen"),caracteristicas=request.getParameter("caracteristicas");Connection con=null;PreparedStatement ps=null;try{con=abrirConexion();con.setAutoCommit(false);if(id==0){ps=con.prepareStatement("INSERT INTO propiedad(id_inmobiliaria,id_ciudad,id_tipo,matricula_inmobiliaria,titulo,descripcion,direccion,precio,area,habitaciones,banos) SELECT id_inmobiliaria,?,?,?,?,?,?,?,?,?,? FROM inmobiliaria WHERE id_usuario=? LIMIT 1");ps.setInt(1,ciudad);ps.setInt(2,tipo);ps.setString(3,matricula);ps.setString(4,titulo);ps.setString(5,descripcion);ps.setString(6,direccion);ps.setDouble(7,precio);ps.setDouble(8,area);ps.setInt(9,habitaciones);ps.setInt(10,banos);ps.setInt(11,idUsuarioSesion);ps.executeUpdate();ps.close();ps=con.prepareStatement("SELECT p.id_propiedad FROM propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE i.id_usuario=? AND p.matricula_inmobiliaria=?");ps.setInt(1,idUsuarioSesion);ps.setString(2,matricula);ResultSet keys=ps.executeQuery();keys.next();id=keys.getInt(1);cerrar(keys);}else{ps=con.prepareStatement("UPDATE propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria SET p.id_ciudad=?,p.id_tipo=?,p.matricula_inmobiliaria=?,p.titulo=?,p.descripcion=?,p.direccion=?,p.precio=?,p.area=?,p.habitaciones=?,p.banos=? WHERE p.id_propiedad=? AND i.id_usuario=?");ps.setInt(1,ciudad);ps.setInt(2,tipo);ps.setString(3,matricula);ps.setString(4,titulo);ps.setString(5,descripcion);ps.setString(6,direccion);ps.setDouble(7,precio);ps.setDouble(8,area);ps.setInt(9,habitaciones);ps.setInt(10,banos);ps.setInt(11,id);ps.setInt(12,idUsuarioSesion);ps.executeUpdate();}cerrar(ps);if(imagen!=null&&!imagen.trim().isEmpty()){ps=con.prepareStatement("INSERT INTO imagen_propiedad(id_propiedad,url,texto_alternativo) VALUES (?,?,?)");ps.setInt(1,id);ps.setString(2,imagen.trim());ps.setString(3,titulo);ps.executeUpdate();cerrar(ps);}if(caracteristicas!=null&&!caracteristicas.trim().isEmpty()){for(String valor:caracteristicas.split(",")){int caracteristica=aEntero(valor,0);if(caracteristica>0){ps=con.prepareStatement("INSERT IGNORE INTO propiedad_caracteristica VALUES (?,?)");ps.setInt(1,id);ps.setInt(2,caracteristica);ps.executeUpdate();cerrar(ps);}}}con.commit();response.sendRedirect(ctx+"/inmobiliaria/propiedades.jsp?msg=Propiedad guardada");}catch(SQLIntegrityConstraintViolationException ex){deshacer(con);response.sendRedirect(ctx+"/inmobiliaria/propiedades.jsp?err=La matrícula ya existe");}catch(SQLException ex){deshacer(con);response.sendRedirect(ctx+"/inmobiliaria/propiedades.jsp?err=No fue posible guardar la propiedad");}finally{cerrar(ps,con);}%>