<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String ctx=request.getContextPath();String[] rolesPermitidos={"INMOBILIARIA"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%int id=aEntero(request.getParameter("id"),0);Connection con=null;PreparedStatement ps=null;try{con=abrirConexion();ps=con.prepareStatement("UPDATE propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria SET p.activo=0,p.estado='INACTIVA' WHERE p.id_propiedad=? AND i.id_usuario=?");ps.setInt(1,id);ps.setInt(2,idUsuarioSesion);ps.executeUpdate();response.sendRedirect(ctx+"/inmobiliaria/propiedades.jsp?msg=Propiedad dada de baja");}catch(SQLException ex){response.sendRedirect(ctx+"/inmobiliaria/propiedades.jsp?err=No fue posible dar de baja");}finally{cerrar(ps,con);}%>