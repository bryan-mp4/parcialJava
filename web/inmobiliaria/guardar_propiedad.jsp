<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String tituloPagina="Editar propiedad"; String ctx=request.getContextPath(); String[] rolesPermitidos={"INMOBILIARIA"}; int id=aEntero(request.getParameter("id"),0); %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><% String titulo="",descripcion="",direccion="",matricula="",imagen=""; double precio=0,area=0; int habitaciones=0,banos=0,ciudad=0,tipo=0; Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();if(id>0){ps=con.prepareStatement("SELECT p.* FROM propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE p.id_propiedad=? AND i.id_usuario=?");ps.setInt(1,id);ps.setInt(2,idUsuarioSesion);rs=ps.executeQuery();if(rs.next()){titulo=rs.getString("titulo");descripcion=rs.getString("descripcion");direccion=rs.getString("direccion");matricula=rs.getString("matricula_inmobiliaria");precio=rs.getDouble("precio");area=rs.getDouble("area");habitaciones=rs.getInt("habitaciones");banos=rs.getInt("banos");ciudad=rs.getInt("id_ciudad");tipo=rs.getInt("id_tipo");}}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><div class="row justify-content-center"><div class="col-lg-9"><div class="card border-0 shadow-sm"><div class="card-body"><h1 class="h3"><%=id>0?"Editar":"Publicar"%> propiedad</h1><form action="guardar_propiedad_accion.jsp" method="post" class="row g-3"><input type="hidden" name="id" value="<%=id%>"><div class="col-md-8"><label class="form-label">Título</label><input name="titulo" class="form-control" value="<%=esc(titulo)%>" required maxlength="150"></div><div class="col-md-4"><label class="form-label">Matrícula</label><input name="matricula" class="form-control" value="<%=esc(matricula)%>" required maxlength="40"></div><div class="col-md-6"><label class="form-label">Ciudad</label><select name="ciudad" class="form-select" required><%try{con=abrirConexion();ps=con.prepareStatement("SELECT id_ciudad,nombre FROM ciudad WHERE activa=1 ORDER BY nombre");rs=ps.executeQuery();while(rs.next()){%><option value="<%=rs.getInt(1)%>" <%=ciudad==rs.getInt(1)?"selected":""%>><%=esc(rs.getString(2))%></option><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></select></div><div class="col-md-6"><label class="form-label">Tipo</label><select name="tipo" class="form-select" required><%try{con=abrirConexion();ps=con.prepareStatement("SELECT id_tipo,nombre FROM tipo_propiedad WHERE activo=1 ORDER BY nombre");rs=ps.executeQuery();while(rs.next()){%><option value="<%=rs.getInt(1)%>" <%=tipo==rs.getInt(1)?"selected":""%>><%=esc(rs.getString(2))%></option><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></select></div><div class="col-12"><label class="form-label">Dirección</label><input name="direccion" class="form-control" value="<%=esc(direccion)%>" required maxlength="180"></div><div class="col-md-3"><label class="form-label">Precio</label><input type="number" name="precio" class="form-control" min="0" step="0.01" value="<%=precio%>" required></div><div class="col-md-3"><label class="form-label">Área m²</label><input type="number" name="area" class="form-control" min="1" step="0.01" value="<%=area%>" required></div><div class="col-md-3"><label class="form-label">Habitaciones</label><input type="number" name="habitaciones" class="form-control" min="0" value="<%=habitaciones%>" required></div><div class="col-md-3"><label class="form-label">Baños</label><input type="number" name="banos" class="form-control" min="0" value="<%=banos%>" required></div><div class="col-12"><label class="form-label">Descripción</label><textarea name="descripcion" class="form-control" maxlength="2000"><%=esc(descripcion)%></textarea></div><div class="col-12"><label class="form-label">URL de imagen principal</label><input name="imagen" class="form-control" maxlength="400" placeholder="https://..."></div><div class="col-12"><label class="form-label">IDs de características separados por coma</label><input name="caracteristicas" class="form-control" placeholder="1,4,5"></div><div class="col-12"><button class="btn btn-primary">Guardar propiedad</button></div></form></div></div></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>