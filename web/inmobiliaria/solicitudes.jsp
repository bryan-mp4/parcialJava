<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String tituloPagina="Solicitudes";String ctx=request.getContextPath();String[] rolesPermitidos={"INMOBILIARIA"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Solicitudes y documentos</h1><div class="table-responsive bg-white shadow-sm"><table class="table align-middle"><thead><tr><th>Cliente</th><th>Propiedad</th><th>Tipo</th><th>Documento</th><th>Estado</th><th>Decisión</th></tr></thead><tbody><%Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();ps=con.prepareStatement("SELECT s.id_solicitud,u.nombre cliente,p.titulo,s.tipo,COALESCE(d.nombre_archivo,'Sin documento'),s.estado FROM solicitud s INNER JOIN usuario u ON u.id_usuario=s.id_usuario INNER JOIN propiedad p ON p.id_propiedad=s.id_propiedad INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria LEFT JOIN documento_solicitud d ON d.id_solicitud=s.id_solicitud WHERE i.id_usuario=? ORDER BY s.creada_en DESC");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(2))%></td><td><%=esc(rs.getString(3))%></td><td><%=esc(rs.getString(4))%></td><td><%=esc(rs.getString(5))%></td><td><span class="badge text-bg-<%=colorEstado(rs.getString(6))%>"><%=esc(rs.getString(6))%></span></td><td><form action="actualizar_solicitud.jsp" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="<%=rs.getInt(1)%>"><button name="estado" value="APROBADA" class="btn btn-sm btn-success">Aprobar</button><button name="estado" value="RECHAZADA" class="btn btn-sm btn-outline-danger">Rechazar</button></form></td></tr><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>