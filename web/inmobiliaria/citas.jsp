<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String tituloPagina="Citas recibidas";String ctx=request.getContextPath();String[] rolesPermitidos={"INMOBILIARIA"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Citas recibidas</h1><div class="table-responsive bg-white shadow-sm"><table class="table"><thead><tr><th>Propiedad</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th></th></tr></thead><tbody><%Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();ps=con.prepareStatement("SELECT c.id_cita,p.titulo,u.nombre cliente,c.fecha_hora,c.estado FROM cita c INNER JOIN propiedad p ON p.id_propiedad=c.id_propiedad INNER JOIN usuario u ON u.id_usuario=c.id_usuario INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE i.id_usuario=? ORDER BY c.fecha_hora");ps.setInt(1,idUsuarioSesion);rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(2))%></td><td><%=esc(rs.getString(3))%></td><td><%=rs.getTimestamp(4)%></td><td><span class="badge text-bg-<%=colorEstado(rs.getString(5))%>"><%=esc(rs.getString(5))%></span></td><td><form action="actualizar_cita.jsp" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="<%=rs.getInt(1)%>"><button name="estado" value="CONFIRMADA" class="btn btn-sm btn-success">Aprobar</button><button name="estado" value="CANCELADA" class="btn btn-sm btn-outline-danger">Rechazar</button></form></td></tr><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>