<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String tituloPagina="Nueva solicitud"; String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><div class="row justify-content-center"><div class="col-md-7"><div class="card border-0 shadow-sm"><div class="card-body"><h1 class="h3">Radicar compra o arriendo</h1><form action="guardar_solicitud.jsp" method="post"><label class="form-label">Propiedad</label><select name="id_propiedad" class="form-select mb-3" required><option value="">Selecciona una</option><% Connection con=null; PreparedStatement ps=null; ResultSet rs=null; try { con=abrirConexion(); ps=con.prepareStatement("SELECT id_propiedad,titulo FROM propiedad WHERE activo=1 AND estado='DISPONIBLE' ORDER BY titulo"); rs=ps.executeQuery(); while(rs.next()) { %><option value="<%= rs.getInt(1) %>"><%= esc(rs.getString(2)) %></option><% }} catch(SQLException ex) { %><% } finally { cerrar(rs,ps,con); } %></select><label class="form-label">Tipo de trámite</label><select name="tipo" class="form-select mb-3" required><option value="COMPRA">Compra</option><option value="ARRIENDO">Arriendo</option></select><label class="form-label">Nombre del documento</label><input name="documento" class="form-control mb-3" placeholder="cedula.pdf o URL segura" maxlength="180" required><button class="btn btn-primary">Enviar solicitud</button></form></div></div></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>