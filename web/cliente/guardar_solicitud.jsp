<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><% int id=aEntero(request.getParameter("id_propiedad"),0); String tipo=request.getParameter("tipo"); String documento=request.getParameter("documento"); Connection con=null; PreparedStatement ps=null; PreparedStatement pd=null; try { con=abrirConexion(); con.setAutoCommit(false); ps=con.prepareStatement("INSERT INTO solicitud(id_propiedad,id_usuario,tipo) VALUES (?,?,?)",Statement.RETURN_GENERATED_KEYS); ps.setInt(1,id); ps.setInt(2,idUsuarioSesion); ps.setString(3,tipo); ps.executeUpdate(); ResultSet claves=ps.getGeneratedKeys(); claves.next(); int solicitud=claves.getInt(1); pd=con.prepareStatement("INSERT INTO documento_solicitud(id_solicitud,nombre_archivo) VALUES (?,?)"); pd.setInt(1,solicitud); pd.setString(2,documento); pd.executeUpdate(); con.commit(); cerrar(claves); response.sendRedirect(ctx+"/cliente/solicitudes.jsp?msg=Solicitud radicada"); } catch(SQLException ex) { deshacer(con); response.sendRedirect(ctx+"/cliente/solicitudes.jsp?err=No fue posible radicar la solicitud"); } finally { cerrar(pd,ps,con); } %>