<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><% int id=aEntero(request.getParameter("id"),0); Connection con=null; PreparedStatement ps=null; try { con=abrirConexion(); ps=con.prepareStatement("INSERT INTO favorito(id_usuario,id_propiedad) VALUES (?,?)"); ps.setInt(1,idUsuarioSesion); ps.setInt(2,id); ps.executeUpdate(); response.sendRedirect(ctx+"/detalle.jsp?id="+id+"&msg=Propiedad guardada en favoritos"); } catch(SQLIntegrityConstraintViolationException ex) { response.sendRedirect(ctx+"/detalle.jsp?id="+id+"&err=La propiedad ya estaba en favoritos"); } catch(SQLException ex) { response.sendRedirect(ctx+"/detalle.jsp?id="+id+"&err=No fue posible guardar el favorito"); } finally { cerrar(ps,con); } %>