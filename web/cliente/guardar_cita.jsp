<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><% int id=aEntero(request.getParameter("id"),0); String fecha=request.getParameter("fecha_hora"); String observaciones=request.getParameter("observaciones"); if(fecha==null || fecha.trim().isEmpty()) { response.sendRedirect(ctx+"/cliente/agendar.jsp?id="+id+"&err=La fecha es obligatoria"); return; } Connection con=null; PreparedStatement ps=null; try { con=abrirConexion(); ps=con.prepareStatement("INSERT INTO cita(id_propiedad,id_usuario,fecha_hora,observaciones) VALUES (?,?,?,?)"); ps.setInt(1,id); ps.setInt(2,idUsuarioSesion); ps.setTimestamp(3,Timestamp.valueOf(fecha.replace('T',' ')+":00")); ps.setString(4,observaciones); ps.executeUpdate(); response.sendRedirect(ctx+"/cliente/citas.jsp?msg=Cita solicitada"); } catch(SQLIntegrityConstraintViolationException ex) { response.sendRedirect(ctx+"/cliente/agendar.jsp?id="+id+"&err=Ese horario ya está ocupado"); } catch(SQLException | IllegalArgumentException ex) { response.sendRedirect(ctx+"/cliente/agendar.jsp?id="+id+"&err=No fue posible agendar la cita"); } finally { cerrar(ps,con); } %>