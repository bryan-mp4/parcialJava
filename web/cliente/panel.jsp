<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String tituloPagina="Mi espacio"; String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<h1 class="h2">Hola, <%= esc(nombreSesion) %></h1><p class="text-muted">Aquí tienes tus búsquedas y gestiones recientes.</p>
<div class="row g-3 mb-4"><% Connection con=null; PreparedStatement ps=null; ResultSet rs=null; try { con=abrirConexion(); ps=con.prepareStatement("SELECT (SELECT COUNT(*) FROM favorito WHERE id_usuario=?) favoritos,(SELECT COUNT(*) FROM cita WHERE id_usuario=? AND estado='PENDIENTE') citas,(SELECT COUNT(*) FROM solicitud WHERE id_usuario=? AND estado='EN_REVISION') solicitudes"); ps.setInt(1,idUsuarioSesion); ps.setInt(2,idUsuarioSesion); ps.setInt(3,idUsuarioSesion); rs=ps.executeQuery(); if(rs.next()){ %><div class="col-md-4"><div class="card stat-card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Favoritos</div><div class="display-6"><%= rs.getInt("favoritos") %></div></div></div></div><div class="col-md-4"><div class="card stat-card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Citas pendientes</div><div class="display-6"><%= rs.getInt("citas") %></div></div></div></div><div class="col-md-4"><div class="card stat-card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Solicitudes en revisión</div><div class="display-6"><%= rs.getInt("solicitudes") %></div></div></div></div><% }} catch(SQLException ex) { %><div class="alert alert-danger">No fue posible cargar el resumen.</div><% } finally { cerrar(rs,ps,con); } %></div>
<div class="row g-3"><div class="col-md-6"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="<%= ctx %>/cliente/favoritos.jsp"><div class="card-body"><i class="bi bi-heart fs-3"></i><h2 class="h5 mt-2">Mis favoritos</h2><p class="text-muted mb-0">Consulta las propiedades que guardaste.</p></div></a></div><div class="col-md-6"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="<%= ctx %>/cliente/solicitudes.jsp"><div class="card-body"><i class="bi bi-folder2-open fs-3"></i><h2 class="h5 mt-2">Mis solicitudes</h2><p class="text-muted mb-0">Radica documentos y revisa estados.</p></div></a></div><div class="col-md-6"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="<%= ctx %>/cliente/citas.jsp"><div class="card-body"><i class="bi bi-calendar3 fs-3"></i><h2 class="h5 mt-2">Mis citas</h2><p class="text-muted mb-0">Consulta tus visitas agendadas.</p></div></a></div><div class="col-md-6"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="<%= ctx %>/cliente/perfil.jsp"><div class="card-body"><i class="bi bi-person-gear fs-3"></i><h2 class="h5 mt-2">Mi perfil</h2><p class="text-muted mb-0">Actualiza tus datos de contacto.</p></div></a></div></div>
