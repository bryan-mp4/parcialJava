<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String tituloPagina="Mis favoritos"; String ctx=request.getContextPath(); String[] rolesPermitidos={"CLIENTE"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Mis favoritos</h1><div class="table-responsive bg-white shadow-sm"><table class="table align-middle"><thead><tr><th>Propiedad</th><th>Ciudad</th><th>Precio</th><th></th></tr></thead><tbody><% Connection con=null; PreparedStatement ps=null; ResultSet rs=null; try { con=abrirConexion(); ps=con.prepareStatement("SELECT p.id_propiedad,p.titulo,c.nombre ciudad,p.precio FROM favorito f INNER JOIN propiedad p ON p.id_propiedad=f.id_propiedad INNER JOIN ciudad c ON c.id_ciudad=p.id_ciudad WHERE f.id_usuario=? ORDER BY f.creado_en DESC"); ps.setInt(1,idUsuarioSesion); rs=ps.executeQuery(); while(rs.next()) { %><tr><td><%= esc(rs.getString("titulo")) %></td><td><%= esc(rs.getString("ciudad")) %></td><td><%= pesos(rs.getDouble("precio")) %></td><td><a class="btn btn-sm btn-outline-primary" href="<%= ctx %>/detalle.jsp?id=<%= rs.getInt("id_propiedad") %>">Ver</a></td></tr><% }} catch(SQLException ex) { %><tr><td colspan="4">No fue posible cargar favoritos.</td></tr><% } finally { cerrar(rs,ps,con); } %></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>