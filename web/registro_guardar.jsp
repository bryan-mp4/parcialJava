<%@ page contentType="text/html; charset=UTF-8" %>
<%@ page import="java.sql.*" %>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% request.setCharacterEncoding("UTF-8"); String nombre=request.getParameter("nombre"); String correo=request.getParameter("correo"); String telefono=request.getParameter("telefono"); String clave=request.getParameter("clave"); String confirmar=request.getParameter("confirmar"); String ctx=request.getContextPath(); if (nombre==null || correo==null || telefono==null || clave==null || !correo.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$") || clave.length()<6 || !clave.equals(confirmar)) { response.sendRedirect(ctx+"/registro.jsp?error=datos"); return; } Connection con=null; PreparedStatement ps=null; PreparedStatement rolPs=null; ResultSet claves=null; try { con=abrirConexion(); con.setAutoCommit(false); ps=con.prepareStatement("INSERT INTO usuario(nombre,correo,telefono,clave) VALUES (?,?,?,?)", Statement.RETURN_GENERATED_KEYS); ps.setString(1,nombre.trim()); ps.setString(2,correo.trim()); ps.setString(3,telefono.trim()); ps.setString(4,claveCifrada(correo.trim(),clave)); ps.executeUpdate(); claves=ps.getGeneratedKeys(); if (!claves.next()) { throw new SQLException("No se pudo obtener el usuario creado"); } int idUsuario=claves.getInt(1); rolPs=con.prepareStatement("INSERT INTO usuario_rol(id_usuario,id_rol) SELECT ?,id_rol FROM rol WHERE nombre=?"); rolPs.setInt(1,idUsuario); rolPs.setString(2,"CLIENTE"); if (rolPs.executeUpdate()!=1) { throw new SQLException("No existe el rol CLIENTE"); } con.commit(); response.sendRedirect(ctx+"/login.jsp?msg=Cuenta creada. Ya puedes ingresar."); } catch (SQLIntegrityConstraintViolationException ex) { deshacer(con); response.sendRedirect(ctx+"/registro.jsp?error=duplicado"); } catch (SQLException ex) { deshacer(con); if (ex.getErrorCode()==1062) response.sendRedirect(ctx+"/registro.jsp?error=duplicado"); else response.sendRedirect(ctx+"/registro.jsp?error=datos"); } finally { cerrar(claves,rolPs,ps,con); } %>