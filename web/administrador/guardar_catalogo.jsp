<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String ctx=request.getContextPath();String[] rolesPermitidos={"ADMINISTRADOR"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%String tipo=request.getParameter("tipo"),nombre=request.getParameter("nombre"),detalle=request.getParameter("detalle");Connection con=null;PreparedStatement ps=null;try{con=abrirConexion();if("ciudad".equals(tipo))ps=con.prepareStatement("INSERT INTO ciudad(nombre,departamento) VALUES (?,?)");else if("propiedad".equals(tipo))ps=con.prepareStatement("INSERT INTO tipo_propiedad(nombre,descripcion) VALUES (?,?)");else ps=con.prepareStatement("INSERT INTO caracteristica(nombre) VALUES (?)");ps.setString(1,nombre);if(!"caracteristica".equals(tipo))ps.setString(2,detalle);ps.executeUpdate();response.sendRedirect(ctx+"/administrador/catalogos.jsp?msg=Catálogo actualizado");}catch(SQLException ex){response.sendRedirect(ctx+"/administrador/catalogos.jsp?err=El registro ya existe o no es válido");}finally{cerrar(ps,con);}%>