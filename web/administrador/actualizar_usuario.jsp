<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String ctx=request.getContextPath();String[] rolesPermitidos={"ADMINISTRADOR"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%int id=aEntero(request.getParameter("id"),0);String accion=request.getParameter("accion");String rol=request.getParameter("rol");Connection con=null;PreparedStatement ps=null;try{con=abrirConexion();con.setAutoCommit(false);if("estado".equals(accion)){ps=con.prepareStatement("UPDATE usuario SET activo=NOT activo WHERE id_usuario=?");ps.setInt(1,id);ps.executeUpdate();}else if("rol".equals(accion)){ps=con.prepareStatement("DELETE FROM usuario_rol WHERE id_usuario=?");ps.setInt(1,id);ps.executeUpdate();cerrar(ps);ps=con.prepareStatement("INSERT INTO usuario_rol(id_usuario,id_rol) SELECT ?,id_rol FROM rol WHERE nombre=?");ps.setInt(1,id);ps.setString(2,rol);ps.executeUpdate();}con.commit();response.sendRedirect(ctx+"/administrador/usuarios.jsp?msg=Usuario actualizado");}catch(SQLException ex){deshacer(con);response.sendRedirect(ctx+"/administrador/usuarios.jsp?err=No fue posible actualizar el usuario");}finally{cerrar(ps,con);}%>