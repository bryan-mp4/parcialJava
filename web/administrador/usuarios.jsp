<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% String tituloPagina="Usuarios"; String ctx=request.getContextPath(); String[] rolesPermitidos={"ADMINISTRADOR"}; %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Usuarios y roles</h1><div class="table-responsive bg-white shadow-sm"><table class="table align-middle"><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acción</th></tr></thead><tbody><%Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();ps=con.prepareStatement("SELECT u.id_usuario,u.nombre,u.correo,u.activo,COALESCE(GROUP_CONCAT(r.nombre SEPARATOR ', '),'SIN ROL') roles FROM usuario u LEFT JOIN usuario_rol ur ON ur.id_usuario=u.id_usuario LEFT JOIN rol r ON r.id_rol=ur.id_rol GROUP BY u.id_usuario ORDER BY u.nombre");rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(2))%></td><td><%=esc(rs.getString(3))%></td><td><%=esc(rs.getString(5))%></td><td><span class="badge text-bg-<%=rs.getBoolean(4)?"success":"danger"%>"><%=rs.getBoolean(4)?"ACTIVA":"INACTIVA"%></span></td><td><form action="actualizar_usuario.jsp" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="<%=rs.getInt(1)%>"><select name="rol" class="form-select form-select-sm"><option>CLIENTE</option><option>INMOBILIARIA</option><option>ADMINISTRADOR</option></select><button name="accion" value="rol" class="btn btn-sm btn-outline-primary">Rol</button><button name="accion" value="estado" class="btn btn-sm btn-outline-secondary"><%=rs.getBoolean(4)?"Inactivar":"Activar"%></button></form></td></tr><%}}catch(SQLException ex){%><tr><td colspan="5">No fue posible cargar usuarios.</td></tr><%}finally{cerrar(rs,ps,con);}%></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>