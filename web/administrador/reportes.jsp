<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.sql.*" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><%@ include file="/WEB-INF/jspf/utilidades.jspf" %><%String tituloPagina="Reportes globales";String[] rolesPermitidos={"ADMINISTRADOR"};%><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="h2">Reportes globales</h1><div class="row g-3"><div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Propiedades por ciudad</h2><table class="table table-sm"><thead><tr><th>Ciudad</th><th>Total</th></tr></thead><tbody><%Connection con=null;PreparedStatement ps=null;ResultSet rs=null;try{con=abrirConexion();ps=con.prepareStatement("SELECT c.nombre,COUNT(p.id_propiedad) total FROM ciudad c LEFT JOIN propiedad p ON p.id_ciudad=c.id_ciudad AND p.activo=1 GROUP BY c.id_ciudad,c.nombre HAVING COUNT(p.id_propiedad)>0 ORDER BY total DESC");rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td><td><%=rs.getInt(2)%></td></tr><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></tbody></table></div></div></div><div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Solicitudes por estado</h2><table class="table table-sm"><thead><tr><th>Estado</th><th>Total</th></tr></thead><tbody><%try{con=abrirConexion();ps=con.prepareStatement("SELECT estado,COUNT(*) total FROM solicitud GROUP BY estado HAVING COUNT(*)>0");rs=ps.executeQuery();while(rs.next()){%><tr><td><%=esc(rs.getString(1))%></td><td><%=rs.getInt(2)%></td></tr><%}}catch(SQLException ex){}finally{cerrar(rs,ps,con);}%></tbody></table></div></div></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>