<%@ page contentType="text/html; charset=UTF-8" %>
<%@ page import="java.sql.*" %>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<%@ include file="/WEB-INF/jspf/utilidades.jspf" %>
<% request.setCharacterEncoding("UTF-8"); String correo=request.getParameter("correo"); String clave=request.getParameter("clave"); String ctx=request.getContextPath(); if (correo==null || clave==null || correo.trim().isEmpty() || clave.isEmpty()) { response.sendRedirect(ctx+"/login.jsp?error=invalido"); return; } Connection con=null; PreparedStatement ps=null; ResultSet rs=null; try { con=abrirConexion(); ps=con.prepareStatement("SELECT u.id_usuario,u.nombre,u.activo,r.nombre rol FROM usuario u INNER JOIN usuario_rol ur ON ur.id_usuario=u.id_usuario INNER JOIN rol r ON r.id_rol=ur.id_rol WHERE u.correo=? AND u.clave=?"); ps.setString(1,correo.trim()); ps.setString(2,claveCifrada(correo.trim(),clave)); rs=ps.executeQuery(); if (!rs.next()) { response.sendRedirect(ctx+"/login.jsp?error=invalido"); return; } if (!rs.getBoolean("activo")) { response.sendRedirect(ctx+"/login.jsp?error=inactivo"); return; } session.invalidate(); session=request.getSession(true); session.setAttribute("idUsuario",rs.getInt("id_usuario")); session.setAttribute("nombre",rs.getString("nombre")); session.setAttribute("rol",rs.getString("rol")); String rol=rs.getString("rol"); if ("CLIENTE".equals(rol)) response.sendRedirect(ctx+"/cliente/panel.jsp"); else if ("INMOBILIARIA".equals(rol)) response.sendRedirect(ctx+"/inmobiliaria/panel.jsp"); else response.sendRedirect(ctx+"/administrador/panel.jsp"); } catch(SQLException ex) { response.sendRedirect(ctx+"/login.jsp?error=invalido"); } finally { cerrar(rs,ps,con); } %>